# Supabase backend — the app's only backend.
# Local dev (Supabase CLI, `supabase start`): http://127.0.0.1:54321
# The CLI prints the anon + service-role keys when it finishes starting.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only: never expose to the browser. Used by API routes/server actions.
SUPABASE_SERVICE_ROLE_KEY=
