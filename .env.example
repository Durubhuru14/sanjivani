# Supabase project settings → API
# Local dev (supabase start): http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only: never expose to the browser. Used by API routes/server actions.
SUPABASE_SERVICE_ROLE_KEY=

# Demo mode (optional) — run the basic in-memory backend with NO Supabase.
# Preferred: `npm run demo` (sets this for you). Set it manually only if you
# want demo mode with a custom start command. Demo data is ephemeral: it
# resets whenever the server restarts.
# NEXT_PUBLIC_DEMO_MODE=1
